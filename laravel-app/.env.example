APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No SQL database: all data is in Firebase (see the FIREBASE_* settings below).

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (forgot-password codes). "log" writes emails to storage/logs/laravel.log,
# which is fine on localhost. To really send them (and on Vercel, set these in
# Project Settings > Environment Variables, never in this file):
#   MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT=587, MAIL_USERNAME, MAIL_PASSWORD,
#   MAIL_FROM_ADDRESS, MAIL_FROM_NAME
# Gmail: smtp.gmail.com with an App Password (not your Google password).
# Vercel blocks port 25; use 587 (or 465 with MAIL_SCHEME=smtps).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Patient messaging (Firestore + push notifications). Path to the Firebase
# service-account JSON. Keep the file OUTSIDE the repo and never commit it.
# On Vercel there is no file: paste the JSON itself into
# FIREBASE_CREDENTIALS_JSON in the project's Environment Variables instead.
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=rehabplus-80675
FIREBASE_API_KEY=

# Optional Firebase transport tuning (defaults shown; see docs/DIAGNOSTICS.md).
# FIREBASE_TIMEOUT=15
# FIREBASE_CONNECT_TIMEOUT=5
# FIREBASE_MAX_ATTEMPTS=3
# FIREBASE_RETRY_BACKOFF_MS=150
# FIREBASE_MAX_PARALLEL=10
# FIREBASE_SLOW_MS=1500
# Proxy to trust for client IPs (api/index.php sets '*' on Vercel).
# TRUSTED_PROXIES=

# Content-Security-Policy: enforce (default) | report-only | off.
# report-only is the quick rollback if a page ever breaks: nothing is blocked,
# violations are still logged as csp.violation.
# CSP_MODE=enforce
